# Virtual environment — recreated from requirements.txt, never committed
.venv/
venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/

# The SQLite database is generated data, not source.
# WAL mode writes two sidecar files next to it that *.db does not match.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Secrets
.env

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini

# The React build's installed packages (ADR 0011, ADR 0025). Recreated from
# frontend/package-lock.json, which IS committed, by `npm ci` in frontend/.
# The built bundle, static/app/, is committed too: the host never runs Node.
node_modules/
